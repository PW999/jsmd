# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
# Load it into your shell before starting the app:  set -a; source .env; set +a

# Required outside the `dev` profile: the single administrator account (no defaults, the app refuses to start without them).
# Under `mvn spring-boot:run` (profile `dev`) they are optional overrides of the built-in admin/admin account.
JSMD_ADMIN_USERNAME=admin
JSMD_ADMIN_PASSWORD=change-me

# Optional: defaults match docker-compose.yml
#JSMD_DB_URL=jdbc:postgresql://localhost:5432/jsmd
#JSMD_DB_USER=jsmd
#JSMD_DB_PASSWORD=jsmd
#PORT=8080

# Optional: directory scanning. Nothing is scanned until at least one directory is set
# (under the `dev` profile ./dev-documents is scanned every minute by default).
# Comma-separated absolute paths; none may be inside another.
#JSMD_SCAN_DIRECTORIES=/data/documents,/mnt/share/scans
#JSMD_SCAN_INTERVAL=PT5M
#JSMD_SCAN_ENABLED=true
#JSMD_SCAN_SETTLE_TIME=PT5S

# Optional: work queue retry behaviour (ISO-8601 durations)
#JSMD_QUEUE_RETRY_DELAY=PT1M
#JSMD_QUEUE_MAX_ATTEMPTS=5
#JSMD_QUEUE_CLAIM_TIMEOUT=PT15M
